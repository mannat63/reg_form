# Copy this file to ".env" and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NOTE: these values ship in the built JS and are publicly visible — the
# Apps Script URL is an endpoint, and the token is only light bot protection.

# The Web App /exec URL from your Apps Script deployment (required).
VITE_SHEETS_URL=

# Optional shared token. If set, it must equal SHARED_TOKEN in Code.gs.
VITE_SHEETS_TOKEN=
